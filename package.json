{
  "name": "arena-fight-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "ci": "pnpm test:unit",
    "battle:clan_clash": "node scripts/battle/run-battle.mjs",
    "battle:clan_clash:example": "node scripts/battle/run-battle.mjs data/battle/examples/attacker.json data/battle/examples/defender.json data/battle/examples/battleResult.json",
    "llm:clan_clash": "node scripts/llm/clan-clash.mjs data/clan_clash/2026-09-18 --full",
    "llm:clan_clash:recursive": "node scripts/llm/clan-clash.mjs data/clan_clash/ --full --recursive 1",
    "llm:clan_clash:test:qwen/qwen3-vl-4b": "cross-env LLM_MODEL=qwen/qwen3-vl-4b node scripts/llm/clan-clash.mjs data/clan_clash/test/qwen_qwen3-vl-4b",
    "llm:clan_clash:test:mistralai/devstral-small-2-2512": "cross-env LLM_MODEL=mistralai/devstral-small-2-2512 node scripts/llm/clan-clash.mjs data/clan_clash/test/mistralai_devstral-small-2-2512",
    "llm:clan_clash:test:google/gemma-4-26b-a4b": "cross-env LLM_MODEL=google/gemma-4-26b-a4b node scripts/llm/clan-clash.mjs data/clan_clash/test/google_gemma-4-26b-a4b",
    "llm:clan_clash:clear-lm-cache": "rimraf \"%USERPROFILE%/.lmstudio/.internal/api-prediction-history/packs\" \"%USERPROFILE%/.cache/lm-studio/.internal/api-prediction-history/packs\"",
    "llm:show-llm-config": "node scripts/llm/show-llm-config.mjs",
    "llm:clan_clash:webp": "node scripts/llm/convert-to-webp.mjs",
    "generate-wiki-table:enemies": "node scripts/generate-wiki-table.mjs data/clan_clash/2026-09-18 webp",
    "generate-wiki-table:clan": "node scripts/generate-wiki-table.mjs data/clan_clash/2026-09-18/clan jpg png",
    "generate-wiki-table:clan:duels": "node scripts/generate-wiki-table.mjs data/clan_clash/2026-09-18/clan_duels jpg png",
    "ocr:enemy:latin": "node scripts/ocr/convert-text-to-latin.mjs",
    "ocr:enemy": "node scripts/ocr/ocr-enemy.mjs",
    "ocr:enemies": "node scripts/ocr/ocr-enemy.mjs",
    "ocr:enemy:name": "node scripts/ocr/ocr-enemy-name.mjs",
    "ocr:enemy:power": "node scripts/ocr/ocr-enemy-power.mjs",
    "ocr:enemies:process": "pnpm ocr:enemies && pnpm llm:clan_clash:webp",
    "extract:image:name": "node scripts/extract_image.mjs data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.07.04_12.27.26.944.png data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.07.04_12.27.26.944_name.webp 486 118 290 36",
    "extract:image:power": "node scripts/extract_image.mjs data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.07.04_12.27.26.944.png data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.07.04_12.27.26.944_power.webp 666 234 162 24"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.1.4",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
