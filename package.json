{
  "name": "arena-fight-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "ci": "pnpm lint && pnpm build && pnpm test:unit",
    "llm:convert": "cross-env LLM_MODEL=google/gemma-4-e4b npm run llm:convert:clear-lm-cache && node scripts/llm/convert.js data/enemies/test",
    "llm:convert:test:google/gemma-4-26b-a4b": "cross-env LLM_MODEL=google/gemma-4-26b-a4-26b-a4b npm run llm:convert:clear-lm-cache && node scripts/llm/convert.js data/enemies/test/google_gemma-4-26b-a4b // 2.3m",
    "llm:convert:test:google/gemma-4-e4b": "cross-env LLM_MODEL=google/gemma-4-e4b npm run llm:convert:clear-lm-cache && node scripts/llm/convert.js data/enemies/test/google_gemma-4-e4b // 1.3m",
    "llm:convert:test:google/gemma-4-e2b": "cross-env LLM_MODEL=google/gemma-4-e2b npm run llm:convert:clear-lm-cache && node scripts/llm/convert.js data/enemies/test/google_gemma-4-e2b // 49.5s, but wrong",
    "llm:convert:clear-lm-cache": "rimraf \"%USERPROFILE%/.lmstudio/.internal/api-prediction-history/packs\" \"%USERPROFILE%/.cache/lm-studio/.internal/api-prediction-history/packs\"",
    "llm:show-llm-config": "node scripts/llm/show-llm-config.mjs",
    "llm:convert:webp": "node scripts/llm/convert-to-webp.mjs",
    "ocr:enemy:latin": "node scripts/ocr/convert-text-to-latin.mjs",
    "ocr:enemy": "node scripts/ocr/ocr-enemy.mjs",
    "ocr:enemies": "node scripts/ocr/ocr-enemy.mjs",
    "ocr:enemy:name": "node scripts/ocr/ocr-enemy-name.mjs",
    "ocr:enemy:power": "node scripts/ocr/ocr-enemy-power.mjs",
    "ocr:enemies:process": "pnpm ocr:enemies && pnpm convert:webp"
  },
  "scriptsComment": {
    "llm:convert:test:google/gemma-4-e4b": "approx runtime: 2.3m",
    "llm:convert:test:google/gemma-4-e2b": "approx runtime: 57.7s"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@reduxjs/toolkit": "^2.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "redux-saga": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "rimraf": "^6.0.1",
    "dotenv": "^16.1.4",
    "cross-env": "^7.0.3",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "tesseract.js"
    ]
  }
}