{
  "name": "kingdom-clash-duel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check:imports": "node scripts/check-imports.mjs",
    "ci": "pnpm test:unit && pnpm check:imports",
    "battle:clan_clash": "node scripts/battle/run-battle.mjs",
    "battle:clan_clash:example": "node scripts/battle/run-battle.mjs data/battle/examples/attacker.json data/battle/examples/defender.json data/battle/examples/battleResult.json",
    "llm:clan_clash": "cross-env LLM_MODEL=qwen/qwen3-vl-8b node scripts/llm/clan-clash.mjs --full",
    "llm:clan_clash:recursive": "cross-env LLM_MODEL=qwen/qwen3-vl-8b node scripts/llm/clan-clash.mjs data/clan_clash/ --full --recursive 1",
    "llm:clan_clash:test:qwen/qwen3-vl-8b": "cross-env LLM_MODEL=qwen/qwen3-vl-8b node scripts/llm/clan-clash.mjs data/clan_clash/test/qwen_qwen3-vl-4b",
    "llm:clan_clash:test:mistralai/devstral-small-2-2512": "cross-env LLM_MODEL=mistralai/devstral-small-2-2512 node scripts/llm/clan-clash.mjs data/clan_clash/test/mistralai_devstral-small-2-2512",
    "llm:clan_clash:test:google/gemma-4-26b-a4b": "cross-env LLM_MODEL=google/gemma-4-26b-a4b node scripts/llm/clan-clash.mjs data/clan_clash/test/google_gemma-4-26b-a4b",
    "llm:clan_clash:clear-lm-cache": "node scripts/llm/clear-lm-prediction-cache.mjs",
    "llm:show-llm-config": "node scripts/llm/show-llm-config.mjs",
    "llm:convert:webp": "node scripts/llm/convert-to-webp.mjs",
    "generate-wiki-table:enemies": "node scripts/generate-wiki-table.mjs data/clan_clash/2026-11-06 webp",
    "generate-wiki-table:clan": "node scripts/generate-wiki-table.mjs data/clan_clash/2026-11-06/clan jpg png",
    "generate-wiki-table:duels": "node scripts/generate-wiki-matrix.mjs data/clan_clash/2026-10-30/duels jpg png webp --compact --height 600",
    "ocr:enemy:latin": "node scripts/ocr/convert-text-to-latin.mjs",
    "ocr:enemy": "node scripts/ocr/ocr-enemy.mjs",
    "ocr:enemy:name": "node scripts/ocr/ocr-enemy-name.mjs",
    "ocr:enemy:power": "node scripts/ocr/ocr-enemy-power.mjs",
    "ocr:rename-enemies": "node scripts/llm/rename-enemies.mjs",
    "ocr:clan": "node scripts/ocr/ocr-clan.mjs",
    "eval:clan-ocr": "node scripts/ocr/eval-clan-ocr.mjs",
    "ocr:enemies:process": "pnpm ocr:enemy && pnpm llm:convert:webp",
    "extract:image:name:enemy": "node scripts/extract_image.mjs data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.07.04_12.27.26.944.png data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.07.04_12.27.26.944_name.webp 486 118 290 36",
    "extract:image:power:enemy": "node scripts/extract_image.mjs data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.07.04_12.27.26.944.png data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.07.04_12.27.26.944_power.webp 666 234 162 24",
    "extract:image:name:clan": "node scripts/extract_image.mjs data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.11.05_23.24.05.991.png data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.11.05_23.24.05.991_name.webp 498 57 400 48",
    "extract:image:power:clan": "node scripts/extract_image.mjs data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.11.05_23.24.05.991.png data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.11.05_23.24.05.991_power.webp 360 122 180 36",
    "extract:image:name:clan:2": "node scripts/extract_image.mjs data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.11.05_23.21.15.925.png data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.11.05_23.21.15.925_name.webp 460 57 400 48",
    "extract:image:power:clan:2": "node scripts/extract_image.mjs data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.11.05_23.21.15.925.png data/clan_clash/test/qwen_qwen3-vl-4b/Screenshot_2026.11.05_23.21.15.925_power.webp 360 122 180 36",
    "test:coverage": "vitest run --coverage",
    "eval:arena-ocr": "node scripts/ocr/eval-arena-ocr.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "3.2.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.1.4",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
