                    }
                },
                "context": "global"
            }
        }
    },
    "isMidasNotBought": {
        "key": "isMidasNotBought",
        "title": "Ни разу не куплен Мидас",
        "command": {
            "eq": {
                "a": {
                    "counterGetOrZero": {
                        "counterId": "hand_of_midas",
                        "context": "user"
                    }
                },
                "b": {
                    "integer": {
                        "value": 0,
                        "context": "global"
                    }
                },
                "context": "compare"
            }
        }
    },
    "isVipNotBought": {
        "key": "isVipNotBought",
        "title": "Ни разу не куплен ViP",
        "command": {
            "eq": {
                "a": {
                    "counterGetOrZero": {
                        "counterId": "vip_subscription",
                        "context": "user"
                    }
                },
                "b": {
                    "integer": {
                        "value": 0,
                        "context": "global"
                    }
                },
                "context": "compare"
            }
        }
    },
    "isRouletteNoLock": {
        "key": "isRouletteNoLock",
        "title": "Рулетка не заблокирована",
        "command": {
            "and": {
                "items": [
                    {
                        "rouletteIsActive": {
