{
    "cleric_IsNotMax": {
        "key": "cleric_IsNotMax",
        "title": "Не максимальный Cleric",
        "command": {
            "not": {
                "command": {
                    "heroIsMaxOrEnoughShards": {
                        "heroId": "clericHero",
                        "context": "user"
                    }
                },
                "context": "global"
            }
        }
    },
    "merida_IsNotMax": {
        "key": "merida_IsNotMax",
        "title": "Не максимальная Merida",
        "command": {
            "not": {
                "command": {
                    "heroIsMaxOrEnoughShards": {
                        "heroId": "accurateMerida",
